<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POSsystem</title>
    
    <!-- Bootstrap CSS -->
    
    <link rel="stylesheet" href="~/datatables/css/dataTables.bootstrap.css" />


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <script src="~/js/theme-manager.js"></script>

    <!-- DataTables Bootstrap 5 CSS -->
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo-icon">
                    <i class='bx bx-cart-alt'></i>
                </div>
                <div class="sidebar-logo-text">
                    <h4>POSsystem</h4>
                    <span>Enterprise POS</span>
                </div>
            </div>
            
            <div class="sidebar-user-info">
                <p class="user-name">@(User.Identity.Name ?? "Usuario")</p>
                <p class="user-role">@(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Rol")</p>
            </div>
            
            <nav class="sidebar-nav">
                <div class="nav-item">
                    <a href="/" class="nav-link active">
                        <i class='bx bx-grid-alt'></i>
                        <span>Dashboard</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="javascript:void(0)" 
                       data-url="@Url.Action("Index", "POS")" 
                       class="nav-link ajax-link" data-script="/js/POS.js">
                        <i class='bx bx-cart-alt'></i>
                        <span>POS</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="javascript:void(0)" 
                       data-url="@Url.Action("Index", "Caja")" 
                       class="nav-link ajax-link" data-script="/js/Caja.js">
                        <i class='bx bx-dollar-circle'></i>
                        <span>Caja</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="javascript:void(0)" 
                       data-url="@Url.Action("Index", "Facturacion")" 
                       class="nav-link ajax-link" data-script="/js/Facturacion.js">
                        <i class='bx bx-file'></i>
                        <span>Facturación</span>
                    </a>
                </div>
                @if (User.IsInRole("Administrador"))
                {
                    <div class="nav-item">
                        <a href="javascript:void(0)" data-url="@Url.Action("Index", "Productos")" class="nav-link ajax-link" data-script="/js/Productos.js">
                            <i class='bx bx-box'></i>
                            <span>Inventario</span>
                        </a>
                    </div>

                    <div class="nav-item">
                        <a href="javascript:void(0)"
                           data-url="@Url.Action("Index", "Bodegas")"
                           class="nav-link ajax-link"
                           data-script="/js/Bodegas.js">
                            <i class='bx bx-buildings'></i>
                            <span>Bodegas</span>
                        </a>
                    </div>

                    <div class="nav-item">
                        <a href="javascript:void(0)" 
                           data-url="@Url.Action("Index", "Logs")" 
                           class="nav-link ajax-link" data-script="/js/Logs.js">
                            <i class='bx bx-list-check'></i>
                            <span>Auditoría</span>
                        </a>
                    </div>
                    /*<div class="nav-item">
                        <a href="#" class="nav-link">
                            <i class='bx bx-bar-chart-alt-2'></i>
                            <span>Reportes</span>
                        </a>
                    </div>*/
                    <div class="nav-item">
                        <a href="javascript:void(0)" 
                           data-url="@Url.Action("Index", "Usuario")" 
                           class="nav-link ajax-link" data-script="/js/Usuario.js">
                            <i class='bx bxs-user alt-2'></i>
                            <span>Usuarios</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="javascript:void(0)" 
                           data-url="@Url.Action("Index", "Roles")" 
                           class="nav-link ajax-link" data-script="/js/Roles.js">
                            <i class='bx bxs-user-detail alt-2'></i>
                            <span>Roles</span>
                        </a>
                    </div>
                }
            </nav>
            
            <div class="sidebar-footer">
                <div class="nav-item m-0 p-0">
                    <a href="#" class="nav-link">
                        <i class='bx bx-cog'></i>
                        <span>Configuración</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Panel -->
        <main class="main-panel">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-title">
                    <h2>POSsystem</h2>
                </div>
                <div class="header-right">
                    <div class="header-time">
                        <i class='bx bx-time-five'></i>
                        <span id="current-time">09:52 p. m.</span>
                    </div>
                    <div class="header-user dropdown">
                        <div class="d-flex align-items-center" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="cursor:pointer">
                            <div class="header-avatar me-2">
                                <i class='bx bx-user'></i>
                            </div>
                            <div class="header-user-details">
                                <span class="name">@(User.Identity.Name ?? "Usuario")</span>
                                <span class="email" style="font-size:12px; color:#6c757d; display:block">@(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Rol")</span>
                            </div>
                            <i class='bx bx-chevron-down ms-2'></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown" style="min-width:200px">
                            <li><a class="dropdown-item d-flex align-items-center" href="#" id="theme-toggle"><i class='bx bx-moon me-2'></i> <span>Modo Oscuro</span></a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item d-flex align-items-center text-danger" href="@Url.Action("Logout", "Login")"><i class='bx bx-log-out me-2'></i> Cerrar Sesión</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <div class="content-area" id="main-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables JS (Core + Bootstrap 5 Integration) -->
    <script src="~/sweetalert2/sweetalert2.all.js"></script>
    <script src="~/js/SweetAlertUtils.js"></script>
    <script src="~/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/datatables/js/dataTables.bootstrap.js"></script>


    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
