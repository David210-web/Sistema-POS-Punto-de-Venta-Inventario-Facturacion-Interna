@using SistemaFacturacionPOS.Models
@{
    ViewData["Title"] = "Configuración";
    var usuario = ViewBag.Usuario as Usuario;
    var empresa = ViewBag.Empresa as Empresa;
    var activeSessions = ViewBag.ActiveSessionsCount;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Perfil Section -->
            <div class="card shadow-sm border-0 mb-4 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="avatar-circle me-3 bg-primary text-white d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 50%; font-size: 24px;">
                            <i class='bx bx-user'></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">Mi Perfil</h5>
                            <small class="text-muted">@usuario?.Username</small>
                        </div>
                    </div>
                    
                    <form id="form-profile" class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Nombre</label>
                            <input type="text" name="nombre" class="form-control bg-light border-0 py-2" value="@usuario?.Nombre" placeholder="Nombre">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Apellido</label>
                            <input type="text" name="apellido" class="form-control bg-light border-0 py-2" value="@usuario?.Apellido" placeholder="Apellido">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Usuario</label>
                            <input type="text" class="form-control bg-light border-0 py-2" value="@usuario?.Username" readonly disabled>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Rol</label>
                            <input type="text" class="form-control bg-light border-0 py-2" value="@usuario?.Rol?.Nombre" readonly disabled>
                        </div>
                        <div class="col-12 mt-3 text-end">
                            <button type="submit" class="btn btn-primary px-4 rounded-3">Guardar Perfil</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Seguridad Section -->
            <div class="card shadow-sm border-0 mb-4 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4 text-primary">
                        <i class='bx bx-lock-alt me-2 fs-4'></i>
                        <h5 class="mb-0 fw-bold">Seguridad</h5>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold">Contraseña</label>
                        <div class="d-block">
                            <button type="button" class="btn btn-outline-primary rounded-3" data-bs-toggle="modal" data-bs-target="#modalPassword">
                                Cambiar Contraseña
                            </button>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-secondary small fw-bold">Sesiones Activas</label>
                        <p class="text-muted small">Actualmente hay @activeSessions sesión(es) activa(s)</p>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-3">Ver Sesiones</button>
                    </div>
                </div>
            </div>

            <!-- Empresa Section -->
            <div class="card shadow-sm border-0 mb-4 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4 text-primary">
                        <i class='bx bx-buildings me-2 fs-4'></i>
                        <h5 class="mb-0 fw-bold">Empresa</h5>
                    </div>

                    <form id="form-empresa">
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Nombre de la Empresa</label>
                            <input type="text" name="nombre" class="form-control bg-light border-0 py-2" value="@empresa?.Nombre" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">NIT</label>
                            <input type="text" name="nit" class="form-control bg-light border-0 py-2" value="@empresa?.Nit">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Dirección</label>
                            <input type="text" name="direccion" class="form-control bg-light border-0 py-2" value="@empresa?.Direccion">
                        </div>
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cambiar Contraseña -->
<div class="modal fade" id="modalPassword" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Cambiar Contraseña</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="form-password">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Contraseña Actual</label>
                        <input type="password" name="currentPassword" class="form-control bg-light border-0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Nueva Contraseña</label>
                        <input type="password" name="newPassword" class="form-control bg-light border-0" required minlength="6">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Confirmar Nueva Contraseña</label>
                        <input type="password" name="confirmPassword" class="form-control bg-light border-0" required>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-3">Actualizar Contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/Configuracion.js"></script>
