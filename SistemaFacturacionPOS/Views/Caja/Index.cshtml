@model SistemaFacturacionPOS.Models.ViewModels.CajaViewModel

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 fw-bold text-dark">Caja</h1>
            <p class="text-muted">Apertura y cierre de caja</p>
        </div>
    </div>

    @if (!Model.CajaAbierta)
    {
        <!-- Caja Cerrada Panel -->
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="me-3 text-dark">
                    <i class='bx bx-error-circle fs-3'></i>
                </div>
                <div class="flex-grow-1">
                    <h5 class="mb-1 fw-bold text-dark">Caja Cerrada</h5>
                    <p class="mb-0 text-muted">Debe abrir la caja para continuar con las ventas</p>
                </div>
                <div>
                    <button class="btn btn-primary px-4 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#abrirCajaModal">Abrir Caja</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Caja Abierta Panel -->
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="me-3 text-dark">
                        <i class='bx bx-check-circle fs-3'></i>
                    </div>
                    <div>
                        <h5 class="mb-2 fw-bold text-dark">Caja Abierta</h5>
                        <p class="mb-1 text-muted" style="font-size: 14px;">Monto Inicial:</p>
                        <p class="mb-0 text-muted" style="font-size: 14px;">Abierta desde:</p>
                    </div>
                </div>
                <div class="text-end">
                    <p class="mb-2 fw-bold text-dark">@Model.MontoInicial.ToString("C")</p>
                    <p class="mb-0 fw-bold text-dark" style="font-size: 14px;">@Model.AbiertaDesde.ToString("h:mm:ss tt")</p>
                </div>
            </div>
            <div class="card-footer bg-white border-0 text-end pb-4 pe-4">
                <button class="btn btn-outline-danger px-4 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#cerrarCajaModal">Cerrar Caja</button>
            </div>
        </div>

        <div class="row mb-4">
            <!-- Monto Inicial -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1" style="font-size: 13px;">Monto Inicial</p>
                            <h4 class="mb-0 fw-bold text-dark">@Model.MontoInicial.ToString("C")</h4>
                        </div>
                        <div class="p-2 rounded bg-primary bg-opacity-10 text-primary">
                            <i class='bx bx-dollar fs-4'></i>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Ventas del Día -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1" style="font-size: 13px;">Ventas del Día</p>
                            <h4 class="mb-1 fw-bold text-dark">@Model.VentasDelDia.ToString("C")</h4>
                            <small class="text-muted">@Model.CantidadTransacciones transacciones</small>
                        </div>
                        <div class="p-2 rounded bg-success bg-opacity-10 text-success">
                            <i class='bx bx-trending-up fs-4'></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tiempo Abierta -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1" style="font-size: 13px;">Tiempo Abierta</p>
                            <h4 class="mb-1 fw-bold text-dark">@Model.TiempoAbierta</h4>
                            <small class="text-muted">Desde: @Model.AbiertaDesde.ToString("h:mm:ss tt")</small>
                        </div>
                        <div class="p-2 rounded bg-warning bg-opacity-10 text-warning">
                            <i class='bx bx-time fs-4'></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Últimas Transacciones -->
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4 text-dark">Últimas Transacciones</h5>
                @if (Model.UltimasTransacciones.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <tbody>
                                @foreach (var trans in Model.UltimasTransacciones)
                                {
                                    <tr class="border-bottom">
                                        <td class="py-3 px-0">
                                            <p class="mb-0 fw-semibold text-dark">@trans.Folio</p>
                                            <small class="text-muted">@trans.Hora</small>
                                        </td>
                                        <td class="text-end py-3 px-0 fw-semibold text-dark">
                                            @trans.Total.ToString("C")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No hay transacciones aún.</p>
                }
            </div>
        </div>
    }

    <!-- Modal Abrir Caja -->
    <div class="modal fade" id="abrirCajaModal" tabindex="-1" aria-labelledby="abrirCajaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-3">
                <div class="modal-header border-0 pb-0 mt-3 px-4">
                    <h5 class="modal-title fw-bold text-dark" id="abrirCajaModalLabel" style="font-size: 24px;">Abrir Caja</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-3 px-4 pb-4">
                    <div class="alert alert-primary bg-primary bg-opacity-10 border-primary border-opacity-25 text-primary mb-4" role="alert">
                        Ingrese el monto de dinero inicial en la caja para comenzar el turno.
                    </div>
                    <form id="formAbrirCaja">
                        <div class="mb-4">
                            <label for="montoInicial" class="form-label fw-semibold text-dark">Monto Inicial</label>
                            <input type="number" class="form-control form-control-lg border-primary border-opacity-50 text-dark fw-bold" style="border-width: 2px;" id="montoInicial" value="0" min="0.01" step="0.01" required>
                            <div class="form-text mt-2 text-muted" id="montoPreview">Monto: $0.00</div>
                        </div>
                        <div class="d-flex justify-content-between gap-3 mt-4">
                            <button type="button" class="btn btn-outline-secondary w-50 py-2 rounded-3" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary w-50 py-2 rounded-3">Abrir Caja</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Cerrar Caja -->
    <div class="modal fade" id="cerrarCajaModal" tabindex="-1" aria-labelledby="cerrarCajaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-3">
                <div class="modal-header border-0 pb-0 mt-3 px-4">
                    <h5 class="modal-title fw-bold text-danger" id="cerrarCajaModalLabel" style="font-size: 24px;">Cerrar Caja</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-3 px-4 pb-4">
                    <div class="alert alert-warning bg-warning bg-opacity-10 border-warning border-opacity-25 text-warning mb-4" role="alert">
                        <strong>Atención:</strong> Al cerrar la caja, ya no se podrán realizar más ventas en este turno.
                        <br><br>
                        Ventas Registradas en Sistema: <strong>@Model.VentasDelDia.ToString("C")</strong><br>
                        Monto Inicial: <strong>@Model.MontoInicial.ToString("C")</strong><br>
                        Total Esperado en Caja: <strong>@((Model.VentasDelDia + Model.MontoInicial).ToString("C"))</strong>
                    </div>
                    <form id="formCerrarCaja">
                        <div class="mb-4">
                            <label for="montoFisico" class="form-label fw-semibold text-dark">Monto Físico en Caja (Arqueo)</label>
                            <input type="number" class="form-control form-control-lg border-warning border-opacity-50 text-dark fw-bold" style="border-width: 2px;" id="montoFisico" value="0" min="0" step="0.01" required>
                            <div class="form-text mt-2 text-muted" id="montoFisicoPreview">Monto: $0.00</div>
                        </div>
                        <div class="d-flex justify-content-between gap-3 mt-4">
                            <button type="button" class="btn btn-outline-secondary w-50 py-2 rounded-3" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger w-50 py-2 rounded-3">Confirmar Cierre</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
